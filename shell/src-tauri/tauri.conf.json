{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempora",
  "version": "0.1.0",
  "identifier": "cc.tempora.shell",
  "build": {
    "frontendDist": "../../app/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tempora",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true,
        "url": "http://127.0.0.1:8787/",
        "additionalBrowserArgs": "--remote-debugging-port=9333 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/128x128.png", "icons/32x32.png"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
